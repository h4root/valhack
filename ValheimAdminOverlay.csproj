<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ValheimAdminOverlay</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblySearchPaths>$(AssemblySearchPaths);{HintPathFromItem}</AssemblySearchPaths>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ValheimPath)' == ''">
    <ValheimPath>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimPath>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedPath>$(ValheimPath)\valheim_Data\Managed</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.10.2" />
  </ItemGroup>

  <ItemGroup>
    <GameReference Include="assembly_valheim" />
    <GameReference Include="assembly_utils" />
    <GameReference Include="UnityEngine" />
    <GameReference Include="UnityEngine.CoreModule" />
    <GameReference Include="UnityEngine.IMGUIModule" />
    <GameReference Include="UnityEngine.InputLegacyModule" />
    <GameReference Include="UnityEngine.TextRenderingModule" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="@(GameReference)">
      <HintPath>$(ManagedPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckReferences" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedPath)\assembly_valheim.dll')"
           Text="Не найден assembly_valheim.dll в '$(ManagedPath)'. Передай -p:ValheimPath=путь к папке игры." />
  </Target>

</Project>
